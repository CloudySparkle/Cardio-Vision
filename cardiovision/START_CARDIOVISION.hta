<!DOCTYPE html>
<html>
<head>
  <title>CardioVision AI Launcher</title>
  <HTA:APPLICATION
    ID="oCardioVisionApp"
    APPLICATIONNAME="CardioVision Launcher"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
  />
  <meta charset="utf-8">
  <style>
    body {
      background: #07111F;
      color: #F4F8FF;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 30px;
      text-align: center;
      user-select: none;
    }
    .badge {
      display: inline-block;
      padding: 4px 12px;
      background: rgba(53, 216, 242, 0.15);
      border: 1px solid #35D8F2;
      color: #35D8F2;
      border-radius: 20px;
      font-size: 11px;
      text-transform: uppercase;
      font-weight: bold;
      letter-spacing: 1px;
      margin-bottom: 12px;
    }
    h2 {
      margin: 0 0 10px 0;
      font-size: 24px;
      color: #ffffff;
    }
    p {
      color: #9BAFC5;
      font-size: 13px;
      margin-bottom: 24px;
      line-height: 1.5;
    }
    .spinner {
      margin: 20px auto;
      width: 40px;
      height: 40px;
      border: 4px solid #1E2F45;
      border-top: 4px solid #35D8F2;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .status {
      font-size: 14px;
      font-weight: 600;
      color: #10B981;
      margin-top: 15px;
    }
    .button {
      margin-top: 20px;
      padding: 12px 24px;
      background: #35D8F2;
      color: #07111F;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      display: inline-block;
      text-decoration: none;
    }
  </style>
  <script language="VBScript">
    Sub Window_OnLoad
      window.resizeTo 540, 420
      Dim fso, shell, curDir, pyExe, cmd
      Set fso = CreateObject("Scripting.FileSystemObject")
      Set shell = CreateObject("WScript.Shell")
      
      ' Get current folder
      curDir = fso.GetParentFolderName(document.location.pathname)
      pyExe = curDir & "\.venv\Scripts\python.exe"

      ' Launch the silent background server
      If fso.FileExists(pyExe) Then
        cmd = "cmd.exe /c cd /d """ & curDir & """ && """ & pyExe & """ -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000"
        shell.Run cmd, 0, False
      End If

      ' Wait 2 seconds and open browser
      window.setTimeout "OpenBrowser", 2200
    End Sub

    Sub OpenBrowser
      Dim shell
      Set shell = CreateObject("WScript.Shell")
      shell.Run "http://127.0.0.1:8000/", 1, False
      document.getElementById("statusMsg").innerText = "Application launched in your browser!"
      window.setTimeout "CloseMe", 2500
    End Sub

    Sub CloseMe
      window.close
    End Sub
  </script>
</head>
<body>
  <div class="badge">🫀 CardioVision AI</div>
  <h2>Starting CardioVision AI</h2>
  <p>Initializing Machine Learning models, SHAP explainability engine, and 3D coronary anatomy viewer...</p>
  
  <div class="spinner"></div>
  <div class="status" id="statusMsg">Launching background server &amp; opening browser...</div>
</body>
</html>
